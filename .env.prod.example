# Production .env — copy to the host (Dokploy env) and fill every <...>.
# Secrets are NOT set here: generate them as files with
#   PROD=1 SECRETS_DIR=../files/secrets ./infra/gen-secrets.sh
#   MQTT_PUBLIC_HOST=mqtt.<domain> CERTS_DIR=../files/certs ./infra/gen-certs.sh
# Deploy: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build --wait

APP_ENV=prod
PUBLIC_URL=https://ops.<domain>   # KC_HOSTNAME, OIDC_ISSUER, CORS/ALLOWED_ORIGINS derive from this

SECRETS_DIR=../files/secrets
CERTS_DIR=../files/certs

BACKUP_S3_ENDPOINT=<https://s3.example.com>
BACKUP_S3_BUCKET=wds-backups

# Real-data pages only. List demo flags here only for a sales demo.
VITE_FEATURES=

# Optional: Google sign-in (leave empty to hide the button)
GOOGLE_CLIENT_ID=
# secret goes in $SECRETS_DIR/google_client_secret (gen-secrets.sh), not here
