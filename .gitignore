# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node / Bun — bun.lock is the canonical lockfile (web/Dockerfile uses it);
# `npm install` works locally but never commit its lockfile (it will drift).
node_modules/
dist/
web/package-lock.json

# Env / secrets — demo passwords are documented in .env.example;
# broker material is generated (infra/gen-secrets.sh + infra/gen-certs.sh).
.env
.env.local
infra/secrets/
infra/certs/

# Runtime data
backend/data/
*.db
*.db-wal
*.db-shm

# OS / editor
.DS_Store
.idea/
.vscode/

# DB dumps (doc 18)
backups/

# Garage node config holds rpc_secret/admin_token
deploy/garage/garage.toml

# Datadog captures: design reference only, do not ship (ref/datadog/SOURCES.md)
ref/
*.tmp
.chrome-clone/

# Claude Code local state + executor ledger
.claude/
.superpowers/
.shots/
