# Copy to .env — every value shown is the documented demo default.

# MQTT identities (v4 T6, doc 17): per-identity secrets live in
# infra/secrets/*.pw — generated by `make secrets`, bind-mounted as compose
# secrets, never in env. Broker auth is TLS-only on 8883 (dynsec plugin);
# the plaintext 1883 listener exists only under the test overlay.
# Rotating secrets after first boot requires `docker compose down -v`
# (the dynsec JSON keeps the old credentials in its volume).

# Chaos knob: simulate an untrusted edge clock (ms offset). 0 = off.
EDGE_CLOCK_SKEW_MS=0

# Frontend origin allowed by backend CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting (v4 T4). Defaults shown; unset = these values.
#RATE_COMMANDS_PER_TAG=5      # per 10 s, per user+tag -> 429 + Retry-After
#RATE_MUTATIONS_PER_USER=60   # per 60 s, non-command mutations -> 429
#RATE_WS_PER_IP=20            # concurrent /ws sockets per client IP -> 4403
#RATE_LOGOUT_PER_IP=10        # backchannel-logout POSTs per 60 s per IP -> 429
# X-Real-IP trust — comma-separated CIDRs. Only loopback peers or these
# ranges may set X-Real-IP (the /ws per-IP cap key). compose pins nginx at
# 172.30.10.10 and lists it; leave empty to trust loopback only.
#TRUSTED_PROXIES=172.30.10.10/32
# WS Origin allowlist — comma-separated; empty = same-origin only (Origin
# host must equal the request Host header). Missing Origin = allowed
# (non-browser clients).
#ALLOWED_ORIGINS=https://ops.example.com

# Postgres (ADR-13). Superuser is used ONLY by the first-boot role bootstrap;
# wds_owner only by the migrate job; the backend gets wds_app + wds_system.
# These values are baked into infra/secrets/*.pw by `make secrets` and mounted
# as files — they never appear in `docker inspect` (v4 T7).
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-pass
WDS_OWNER_PASSWORD=owner-dev-pass
WDS_APP_PASSWORD=app-dev-pass
WDS_SYSTEM_PASSWORD=system-dev-pass

# dev = seed the demo org/users on boot AND enable the demo-token auth path.
# PROD: set APP_ENV=prod explicitly. Under prod the backend refuses to start
# (loud SystemExit at import) if any required env is missing or still holds a
# dev-default value: OIDC_ISSUER/OIDC_JWKS_URI, WDS_*_DSN + passwords,
# MQTT_PASSWORD_FILE, DYNSEC_ADMIN_PASSWORD_FILE, SVC_BACKEND_PW_FILE,
# EDGE_BOOTSTRAP_PW_FILE, KC_ADMIN(+password), ALLOWED_ORIGINS, TRUSTED_PROXIES.
APP_ENV=dev

# --- OIDC / Keycloak (v4 T5, ADR-12) --------------------------------------
# Public realm URL — nginx proxies /realms/ to keycloak, so the issuer is
# the web origin. KC_HOSTNAME MUST equal the browser-facing web origin.
KC_HOSTNAME=http://localhost:5173
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin-dev-pass
# password for the realm test users (admin@demo/operator@demo/viewer@demo),
# set by `make seed-dev` — never shipped in the realm JSON
KC_DEMO_PASSWORD=kc-demo-pass
# backend JWT verification (defaults shown; unset = these values)
#OIDC_ISSUER=http://localhost:5173/realms/wds
#OIDC_AUDIENCE=wds-api
#OIDC_CLIENT_ID=wds-web
#OIDC_JWKS_URI=http://keycloak:8080/realms/wds/protocol/openid-connect/certs
#JWKS_TTL_S=600            # bounded JWKS cache
#JWKS_REFETCH_MIN_S=30    # unknown-kid refetch rate limit
#AUTHZ_TTL_S=5            # revocation SLA: revoked_sessions+NOTIFY <= 5s
