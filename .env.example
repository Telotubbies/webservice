# Copy to .env — every value shown is the documented demo default.

# Broker credentials — MUST match infra/passwd (regenerate: ./infra/gen-passwd.sh)
MQTT_PW_EDGE=edge-demo-pass
MQTT_PW_BACKEND=backend-demo-pass
MQTT_PW_TESTER=tester-demo-pass

# Chaos knob: simulate an untrusted edge clock (ms offset). 0 = off.
EDGE_CLOCK_SKEW_MS=0

# Frontend origin allowed by backend CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting (v4 T4). Defaults shown; unset = these values.
#RATE_COMMANDS_PER_TAG=5      # per 10 s, per user+tag -> 429 + Retry-After
#RATE_MUTATIONS_PER_USER=60   # per 60 s, non-command mutations -> 429
#RATE_WS_PER_IP=20            # concurrent /ws sockets per client IP -> 4403
# WS Origin allowlist — comma-separated; empty = same-origin only (Origin
# host must equal the request Host header). Missing Origin = allowed
# (non-browser clients).
#ALLOWED_ORIGINS=https://ops.example.com

# Postgres (ADR-13). Superuser is used ONLY by the first-boot role bootstrap;
# wds_owner only by the migrate job; the backend gets wds_app + wds_system.
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-pass
WDS_OWNER_PASSWORD=owner-dev-pass
WDS_APP_PASSWORD=app-dev-pass
WDS_SYSTEM_PASSWORD=system-dev-pass

# dev = seed the demo org/users on boot. Anything else = no seeding.
APP_ENV=dev
